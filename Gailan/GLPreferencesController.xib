            <value key="maxSize" type="size" width="700" height="440"/>
            <view key="contentView" autoresizesSubviews="NO" id="2">
                <rect key="frame" x="0.0" y="0.0" width="700" height="440"/>
                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                <subviews>

                    <!-- the sidebar: one category per row, source list styling -->

{
  "name": "gailan-server",
  "version": "0.0.0",
  "description": "Node.js backend for Gailan, a fork of Übersicht by Felix Hageloh",
  "main": "server.coffee",
  "scripts": {
    "test": "npm run-script test-local && npm run-script test-dom",
    "test-local": "node spec/run.js -r coffeescript/register 'spec/backend/**/*'",
    "start": "coffee server.coffee",
    "fetch-node": "../scripts/fetch-node.sh",
    "fetch-esbuild": "../scripts/fetch-esbuild.sh",
    "release": "npm run-script fetch-node && npm run-script build-client && npm run-script build-server && npm run-script fetch-esbuild",
    "build-client": "browserify -i ws -t coffeeify -t babelify -r ./src/gailan.js:gailan -r ./src/legacyAlias.js:uebersicht client.coffee | terser -c > release/public/client.js",
    "build-server": "browserify -t coffeeify --node --detect-globals false --no-bundle-external server.coffee > release/server.js && cd release && npm prune --production && npm install --production --no-progress",
    "test-dom": "node spec/run.js -r coffeescript/register -r ./spec/helpers/domEnv.js 'spec/frontend/*.js'"
  },
  "author": "Kevin Chen",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true,
  "devDependencies": {
    "coffeescript": "^2.7.0",
    "jsdom": "^30.0.1",
    "nise": "^6.1.5",
    "sinon": "^22.1.0",
    "tap-arc": "^1.3.2",
    "tape": "^5.10.2",
    "terser": "^5.51.0",
    "tosource": "^1.0.0"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@emotion/babel-plugin": "^11.13.5",
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "babelify": "^10.0.0",
    "browserify": "^17.0.1",
    "byline": "^5.0.0",
    "coffeeify": "^3.0.1",
    "connect": "^3.7.0",
    "convert-source-map": "^2.0.0",
    "cors-anywhere": "^0.4.4",
    "esbuild": "0.25.10",
    "escodegen": "^2.1.0",
    "esprima": "^4.0.1",
    "jquery": "^3.7.1",
    "minimist": "^1.2.8",
    "ms": "^2.1.3",
    "nib": "^1.2.0",
    "raf": "^3.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "redux": "^5.0.1",
    "serve-static": "^2.2.1",
    "source-map": "^0.7.4",
    "stylus": "^0.64.0",
    "superagent": "^10.3.0",
    "through2": "^5.0.11",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.3"
  }
}

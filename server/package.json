{
  "name": "gailan-server",
  "version": "0.0.0",
  "description": "Node.js backend for Gailan, a fork of \u00dcbersicht by Felix Hageloh",
  "main": "server.ts",
  "scripts": {
    "test": "npm run-script test-local && npm run-script test-integration && npm run-script test-dom",
    "test-local": "node spec/run.js 'spec/backend/**/*'",
    "start": "node server.ts",
    "fetch-node": "../scripts/fetch-node.sh",
    "fetch-esbuild": "../scripts/fetch-esbuild.sh",
    "release": "npm run-script fetch-node && npm run-script build-bundles && npm run-script install-runtime-deps && npm run-script fetch-esbuild",
    "build-bundles": "node scripts/build.js",
    "install-runtime-deps": "cd release && npm prune --production && npm install --production --no-progress",
    "test-dom": "node spec/run.js -r ./spec/helpers/domEnv.js 'spec/frontend/*.js'",
    "typecheck": "tsc --noEmit",
    "coverage": "./scripts/coverage.sh",
    "test-integration": "node spec/run.js 'spec/integration/**/*'"
  },
  "author": "Kevin Chen",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "^24.13.3",
    "c8": "^10.1.3",
    "jsdom": "^30.0.1",
    "nise": "^6.1.5",
    "sinon": "^22.1.0",
    "tap-arc": "^1.3.2",
    "tape": "^5.10.2",
    "tosource": "^1.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@emotion/babel-plugin": "^11.13.5",
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "byline": "^5.0.0",
    "connect": "^3.7.0",
    "convert-source-map": "^2.0.0",
    "cors-anywhere": "^0.4.4",
    "esbuild": "0.25.10",
    "escodegen": "^2.1.0",
    "esprima": "^4.0.1",
    "jquery": "^3.7.1",
    "minimist": "^1.2.8",
    "ms": "^2.1.3",
    "nib": "^1.2.0",
    "raf": "^3.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "redux": "^5.0.1",
    "serve-static": "^2.2.1",
    "source-map": "^0.7.4",
    "stylus": "^0.64.0",
    "superagent": "^10.3.0",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.3"
  }
}
